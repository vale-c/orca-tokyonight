{
  "base": "dark",
  "tokens": {
    "--background": "#24283b",
    "--editor-surface": "#24283b",
    "--foreground": "#c0caf5",
    "--card": "#1f2335",
    "--card-foreground": "#c0caf5",
    "--popover": "#1f2335",
    "--popover-foreground": "#c0caf5",
    "--primary": "#7aa2f7",
    "--primary-foreground": "#1d202f",
    "--secondary": "#292e42",
    "--secondary-foreground": "#c0caf5",
    "--muted": "#1f2335",
    "--muted-foreground": "#a9b1d6",
    "--accent": "#292e42",
    "--accent-foreground": "#c0caf5",
    "--border": "#3b4261",
    "--input": "#3b4261",
    "--ring": "#7aa2f7",
    "--chart-1": "#7aa2f7",
    "--chart-2": "#e0af68",
    "--chart-3": "#9ece6a",
    "--chart-4": "#1abc9c",
    "--chart-5": "#bb9af7",
    "--sidebar": "#1f2335",
    "--sidebar-foreground": "#a9b1d6",
    "--sidebar-primary": "#7aa2f7",
    "--sidebar-primary-foreground": "#1d202f",
    "--sidebar-accent": "#292e42",
    "--sidebar-accent-foreground": "#c0caf5",
    "--sidebar-border": "#1d202f",
    "--sidebar-ring": "#7aa2f7"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#67719c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "Builtin variables",
      "scope": [
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#73daca"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "Builtin constants",
      "scope": [
        "support.constant",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "Characters",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b4f9f8"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9d7cd8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": ""
      }
    },
    {
      "name": "Return and await",
      "scope": [
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#9d7cd8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function keyword",
      "scope": [
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports, modules and preprocessor",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.macro",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#7dcfff",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Builtin functions",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a9b1d6"
      }
    },
    {
      "name": "Delimiters and interpolation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "JSX tags",
      "scope": [
        "entity.name.tag.tsx",
        "entity.name.tag.js"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "Tag delimiters",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#73daca"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7aa2f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#1abc9c",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "List markers",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#449dab"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a65e66"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#6183bb"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#db4b4b"
      }
    }
  ]
}
