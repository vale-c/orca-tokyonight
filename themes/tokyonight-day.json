{
  "base": "light",
  "tokens": {
    "--background": "#e1e2e7",
    "--editor-surface": "#e1e2e7",
    "--foreground": "#3760bf",
    "--card": "#d0d5e3",
    "--card-foreground": "#274eab",
    "--popover": "#d0d5e3",
    "--popover-foreground": "#274eab",
    "--primary": "#3760bf",
    "--primary-foreground": "#e1e2e7",
    "--secondary": "#c4c8da",
    "--secondary-foreground": "#274eab",
    "--muted": "#d0d5e3",
    "--muted-foreground": "#495994",
    "--accent": "#c4c8da",
    "--accent-foreground": "#274eab",
    "--border": "#a8aecb",
    "--input": "#a8aecb",
    "--ring": "#3760bf",
    "--chart-1": "#2e7de9",
    "--chart-2": "#8c6c3e",
    "--chart-3": "#587539",
    "--chart-4": "#118c74",
    "--chart-5": "#9854f1",
    "--sidebar": "#d0d5e3",
    "--sidebar-foreground": "#495994",
    "--sidebar-primary": "#3760bf",
    "--sidebar-primary-foreground": "#e1e2e7",
    "--sidebar-accent": "#c4c8da",
    "--sidebar-accent-foreground": "#274eab",
    "--sidebar-border": "#b4b5b9",
    "--sidebar-ring": "#3760bf",
    "--tab-bar": "#cacddd",
    "--tab-active": "#e1e2e7",
    "--tab-active-foreground": "#3058b7",
    "--tab-active-indicator": "#506d9c",
    "--tab-inactive": "#d5d8e2",
    "--tab-inactive-foreground": "#565c7c",
    "--split-divider": "#a8aecb",
    "--split-divider-hover": "#4094a3",
    "--text-link": "#006e80",
    "--diff-added": "#0b717d",
    "--diff-added-background": "#d0e7ee",
    "--diff-added-emphasis": "#c0ebf4",
    "--diff-removed": "#9d555e",
    "--diff-removed-background": "#fcdbdf",
    "--diff-removed-emphasis": "#fcdbdf",
    "--git-decoration-added": "#29828f",
    "--git-decoration-modified": "#506d9c",
    "--git-decoration-deleted": "#ab626b",
    "--git-decoration-renamed": "#188092",
    "--git-decoration-untracked": "#29828f",
    "--git-decoration-copied": "#29828f",
    "--git-decoration-ignored": "#6f7597"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767ea6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#3760bf"
      }
    },
    {
      "name": "Builtin variables",
      "scope": [
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#f32764"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#8c6c3e"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#387068"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#b15c00"
      }
    },
    {
      "name": "Builtin constants",
      "scope": [
        "support.constant",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#188092"
      }
    },
    {
      "name": "Characters",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#587539"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#9854f1"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#587539"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2e5857"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7847bd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#9854f1",
        "fontStyle": ""
      }
    },
    {
      "name": "Return and await",
      "scope": [
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#7847bd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function keyword",
      "scope": [
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#9854f1",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports, modules and preprocessor",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.macro",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#007197",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#006a83",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#2e7de9"
      }
    },
    {
      "name": "Builtin functions",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#188092"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#188092"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6172b0"
      }
    },
    {
      "name": "Delimiters and interpolation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#006a83"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9854f1"
      }
    },
    {
      "name": "JSX tags",
      "scope": [
        "entity.name.tag.tsx",
        "entity.name.tag.js"
      ],
      "settings": {
        "foreground": "#f32764"
      }
    },
    {
      "name": "Tag delimiters",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#188092"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#387068"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#007197"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#2e7de9"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#2e7de9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#118c74",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link"
      ],
      "settings": {
        "foreground": "#188092"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#2e7de9"
      }
    },
    {
      "name": "List markers",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#b15c00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#348b98"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b56b73"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#506d9c"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#c64343"
      }
    }
  ]
}
